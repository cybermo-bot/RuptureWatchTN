# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings, API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server and scripts only. Never in a client component.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used only by `npm run db:push` on the team lead's machine.
SUPABASE_DB_URL=

# Demo role buttons: long random string, server only
DEMO_ACCOUNT_PASSWORD=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_HASH_SALT=
# Tester invite link (/rejoindre/<code>) and the daily recompute cron: long random strings
TESTER_INVITE_CODE=
CRON_SECRET=

# Availability requests: salt for the device id hash (lib/availability/device.ts), server only
DEVICE_HASH_SALT=

# Google Maps JavaScript API, in the browser (components/maps/PatientMap.tsx).
# Restrict this key in Google Cloud: Application restriction "Websites" (HTTP referrers)
# limited to https://rupturewatch-tn.vercel.app/* and the Vercel preview domain, API
# restriction to "Maps JavaScript API" only, and a daily quota cap. Without it, the map
# falls back to OpenStreetMap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Google Places API, server only (app/api/places/nearby/route.ts). Never in client code.
# Restrict this key in Google Cloud: API restriction to "Places API (New)" only, no
# browser use, and a daily quota cap. Responses are never stored or logged (CLAUDE.md rule 13).
GOOGLE_PLACES_API_KEY=
