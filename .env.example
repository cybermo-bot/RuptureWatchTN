# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings, API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server and scripts only. Never in a client component.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used only by `npm run db:push` on the team lead's machine.
SUPABASE_DB_URL=

# Demo role buttons: long random string, server only
DEMO_ACCOUNT_PASSWORD=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_HASH_SALT=
TESTER_INVITE_CODE=
CRON_SECRET=
